# ─────────────────────────────────────────────────────────────────────────────
# Polaris — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy to .env and override as needed. Every value below is the built-in
# default (see polaris/core/config.py), so an empty .env works out of the box
# against the bundled docker-compose Postgres. Loaded once at startup by
# pydantic-settings and validated — bad values fail fast.
#
# Sections marked (planned) are not wired yet; they land with their components.
# ─────────────────────────────────────────────────────────────────────────────


# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Option A: a full DSN wins if set.
# POSTGRES_DSN=postgresql://polaris:polaris@localhost:5432/polaris
#
# Option B: composed from parts (used when POSTGRES_DSN is unset).
# Defaults match docker-compose.yml.
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polaris

# Async connection pool sizing (max must be >= min).
PG_POOL_MIN_CONN=2
PG_POOL_MAX_CONN=10


# ── Binance ──────────────────────────────────────────────────────────────────
# Comma-separated spot pairs (case-insensitive; normalized to upper-case).
BINANCE_SYMBOLS=btcusdt,ethusdt

# Combined-stream websocket base. The app appends ?streams=<sym>@trade/...
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/stream

# Reconnect backoff and websocket keepalive.
BINANCE_RECONNECT_DELAY_SEC=3.0
BINANCE_PING_INTERVAL_SEC=20.0
BINANCE_PING_TIMEOUT_SEC=20.0
BINANCE_MAX_FRAME_BYTES=1048576


# ── Live ingest (WS -> PostgreSQL sink) ──────────────────────────────────────
# Flush the trade buffer when it reaches this many rows...
INGEST_BATCH_SIZE=1000
# ...or when this many seconds pass since the last flush, whichever first.
INGEST_FLUSH_INTERVAL_SEC=1.0
# Apply schema.sql on startup (idempotent). Safe to leave on.
INGEST_ENSURE_SCHEMA=true


# ── Aggregation ───────────────────────────────────────────────────────────────
# WINDOW_SEC=300

# ── Model / estimator ─────────────────────────────────────────────────────────
# These are the untuned starting point. `calibrate` (session 11: MLX-backed,
# real 14-day scale) found bandwidths that move block-CV Brier 0.1871->0.1700
# and the walk-forward win rate 56.4%->62.9% at the same 45-90s trade window
# (see RESEARCH_LOG.md) -- copy its "calibrated config" output into your
# .env to use them; see .env for this repo's current tuned values.
# BW_DELTA=5.0
# BW_TIME=15.0
# BW_MOMENTUM=3.0
# BW_IMBALANCE=0.05
# BW_VOLATILITY=0.3
# BW_TOD=0.4
# PRIOR_ALPHA=2.0
# PRIOR_BETA=2.0
# TRAINING_WINDOW_DAYS=14
# ESTIMATOR_REFRESH_SEC=30.0

# ── Trading constraints ────────────────────────────────────────────────────────
# min_edge=0.05 (not the 0.03 default) is the walk-forward-verified value at
# the tuned bandwidths -- see RESEARCH_LOG.md session 11/12.
# MIN_EDGE=0.03
# MIN_N_EFF=20.0
# MAX_KELLY_FRACTION=0.05
# Tradeable window (session 10 diagnostic + session 11 re-verification on the
# corrected label + tuned bandwidths -- all confirm 45-90s, not Step 2's
# in-sample [172,219] suggestion; see RESEARCH_LOG.md for why that's not
# trusted).
# TRADE_WINDOW_START=45
# TRADE_WINDOW_END=90
